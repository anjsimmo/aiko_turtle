# Copy to ".env" and edit.  ".env" is not committed.  Every variable is
# optional: a value already in the environment wins, then this file, then
# the defaults in config.py.

# Aiko shared services
#AIKO_MQTT_HOST=aiko.hashtag.ai
#AIKO_MQTT_PORT=1883
#AIKO_NAMESPACE=aiko
#AIKO_LOG_LEVEL=INFO

# Python environment whose "bin" env.sh prepends to PATH (optional)
#AIKO_PYTHON_BIN=/path/to/venv/bin

# The world and its database (any SQLAlchemy URL; SQLite needs no server)
#TURTLE_WORLD=turtle_world
#TURTLE_DATABASE_URL=sqlite:///turtle.db
# e.g. TURTLE_DATABASE_URL=postgresql+psycopg://user:pass@host/turtle

# Chat
#TURTLE_CHANNEL=robots
#TURTLE_AGENT=@@pilot

# Web server
#TURTLE_WEB_HOST=127.0.0.1
#TURTLE_WEB_PORT=8123
#TURTLE_USERNAME=anonymous
# Bearer token for POST/DELETE on the REST API; empty or unset = open.
# By default it is shown on the page and in /guide (TURTLE_API_TOKEN_PUBLIC=true)
#TURTLE_API_TOKEN=TURTLES_ALL_THE_WAY_DOWN
#TURTLE_API_TOKEN_PUBLIC=true

# LLM ChatAgent: without a key it falls back to the "claude" CLI
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4o-mini
#TURTLE_LLM_RATE_PER_MINUTE=10
#TURTLE_LLM_USER_RATE_PER_MINUTE=4
#TURTLE_LLM_QUEUE_LIMIT=5
